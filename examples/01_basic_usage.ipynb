   "source": [
    "# Basic Usage\n",
    "\n",
    "Encode a sine wave with a Gramian Angular Field and extract features."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "\n",
    "from tscv_vision import encoders, features\n",
    "\n",
    "t = np.linspace(0, 8*np.pi, 256)\n",
    "x = np.sin(t)\n",
    "img = encoders.gaf(x)\n",
    "vec = features.extract_feature_vector(img)\n",
    "vec.shape\n"
   ]
  }
 ],
