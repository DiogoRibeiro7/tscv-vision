   "source": [
    "import numpy as np\n",
    "from tscv_vision.pipeline import AdaptivePipeline\n",
    "\n",
    "X = np.random.rand(32, 64)\n",
    "y = (X.mean(axis=1) > 0.5).astype(int)\n",
    "pipe = AdaptivePipeline(random_state=0)\n",
    "feats = pipe.fit_transform(X, y)\n",
    "feats.shape\n"
   ]
  }
